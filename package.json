{
  "name": "bhn-training-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "eval": "tsx evals/run.ts --save",
    "eval:ci": "tsx evals/run.ts --no-llm --check",
    "eval:baseline": "tsx evals/run.ts --no-llm --write-baseline",
    "test:e2e": "playwright test --project=setup --project=trainee-chromium --project=admin-chromium",
    "test:page-review:browser": "tsx tests/browser/page-review-overlay.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:unit": "playwright test --project=unit",
    "auth0:preflight": "tsx scripts/auth0-preflight.ts",
    "auth0:provision": "tsx scripts/auth0-provision.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@auth0/nextjs-auth0": "^4.27.0",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/nodemailer": "^8.0.1",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "algoliasearch": "^5.57.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "inngest": "^4.18.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "mammoth": "^1.12.1",
    "next": "16.3.3",
    "next-auth": "4.24.15",
    "nodemailer": "^9.0.6",
    "otplib": "^12.0.1",
    "prisma": "^6.19.3",
    "qrcode-svg": "^1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^15.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.0",
    "scorm-again": "^3.3.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "twilio": "^6.1.0",
    "unpdf": "^1.8.1",
    "unzipper": "^0.12.5",
    "uuid": "^14.0.2",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "@auth/core": "0.41.3",
    "deepmerge-ts": "^8.0.0",
    "js-yaml": "^4.3.1",
    "nodemailer": "^9.0.6"
  }
}
