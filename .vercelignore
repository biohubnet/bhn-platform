# Vercel installs and builds these itself. Without this the CLI can try
# to upload them (.next ~700MB, node_modules ~1.2GB) and the upload
# fails outright as "fetch failed" rather than erroring usefully.
node_modules
.next
tsconfig.tsbuildinfo

# Local-only test + docs artefacts
test-results
playwright-report
docs/screenshots

# Local env files. Vercel injects the real environment variables at build
# time; uploading a local .env would ship developer credentials into the
# build and can silently shadow the project's configured values.
.env
.env.*
!.env.example
