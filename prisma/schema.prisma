generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Roles: user | admin | superadmin | evaluating
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user") // user | admin | superadmin | evaluating
  isActive      Boolean   @default(true)
  credits       Float     @default(5000)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  enrollments        Enrollment[]
  scormSessions      ScormSession[]
  xapiStatements     XapiStatement[]
  certificates       Certificate[]
  instructedCourses  Course[]          @relation("Instructor")
  assessmentAttempts AssessmentAttempt[]
  creditTransactions CreditTransaction[]
  groupMemberships   GroupMembership[]
  auditLogs          AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Course {
  id           String   @id @default(cuid())
  title        String
  description  String?
  thumbnail    String?
  category     String?
  tags         String?
  status       String   @default("draft")
  courseType   String   @default("scorm")
  passingScore Float    @default(80)
  maxAttempts  Int      @default(0)
  duration     Int?
  creditCost   Float    @default(0)
  instructorId String?
  instructor   User?    @relation("Instructor", fields: [instructorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scormPackage ScormPackage?
  modules      Module[]
  enrollments  Enrollment[]
  assessments  Assessment[]
  certificates Certificate[]
  groupCourses GroupCourse[]
}

model ScormPackage {
  id           String   @id @default(cuid())
  courseId     String   @unique
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version      String
  entryPoint   String
  manifestData String
  uploadPath   String
  uploadedAt   DateTime @default(now())
  sessions     ScormSession[]
}

model ScormSession {
  id            String   @id @default(cuid())
  userId        String
  packageId     String
  attemptNumber Int      @default(1)
  status        String   @default("not attempted")
  score         Float?
  scoreMin      Float?
  scoreMax      Float?
  timeSpent     String?
  location      String?
  suspendData   String?
  interactions  String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  type        String   @default("content")
  content     String?
  videoUrl    String?
  fileUrl     String?
  duration    Int?
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress ModuleProgress[]
}

model ModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  status      String   @default("not_started")
  score       Float?
  timeSpent   Int?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([userId, moduleId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  status      String    @default("active")
  score       Float?
  progress    Float     @default(0)
  attempts    Int       @default(0)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  dueDate     DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

model Assessment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  timeLimit   Int?
  passingScore Float   @default(80)
  maxAttempts Int      @default(0)
  shuffleQ    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  AssessmentAttempt[]
}

model Question {
  id            String   @id @default(cuid())
  assessmentId  String
  text          String
  type          String
  options       String?
  correctAnswer String?
  points        Float    @default(1)
  order         Int
  explanation   String?
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
  id           String    @id @default(cuid())
  assessmentId String
  userId       String
  score        Float?
  maxScore     Float?
  passed       Boolean?
  answers      String
  timeSpent    Int?
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XapiStatement {
  id          String   @id @default(cuid())
  statementId String   @unique
  userId      String
  verb        String
  object      String
  result      String?
  context     String?
  timestamp   DateTime @default(now())
  stored      DateTime @default(now())
  authority   String?
  version     String   @default("1.0.3")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LtiConfig {
  id            String   @id @default(cuid())
  name          String
  issuer        String
  clientId      String
  authEndpoint  String
  tokenEndpoint String
  jwksEndpoint  String
  deploymentId  String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Certificate {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  issueDate  DateTime  @default(now())
  expiryDate DateTime?
  metadata   String?
  pdfUrl     String?
  revokedAt  DateTime?
  revokedBy  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String   // credit | debit
  reason      String   // enrollment | refund | admin_grant | initial
  courseId    String?
  balanceAfter Float
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  GroupMembership[]
  courses  GroupCourse[]
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  addedAt   DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}

model GroupCourse {
  id       String @id @default(cuid())
  groupId  String
  courseId String
  addedAt  DateTime @default(now())
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([groupId, courseId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  courseId  String?
  authorId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // user.create | user.deactivate | course.publish | enrollment.create | credit.grant …
  targetType String?  // user | course | enrollment | certificate
  targetId   String?
  detail     String?  // JSON
  ip         String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
