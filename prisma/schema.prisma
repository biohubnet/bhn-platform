generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Roles: user | admin | superadmin | evaluating
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("trainee") // trainee | evaluating | employer | instructor | admin | superadmin
  isActive      Boolean   @default(true)
  credits       Float     @default(200)
  /// Employer-only: whether they can browse the rest of the platform
  /// (Engage / Experience nav). Off by default — employers see their
  /// portal; admins flip on if a partner needs broader access.
  allowPlatformContent Boolean @default(false)
  /// Employer-only: company they post on behalf of. Free text.
  employerCompany String?
  /// Employer-only company-profile fields. AI auto-fill populates them
  /// from the website on demand; user can edit.
  companyWebsite     String?
  companyLogo        String?
  companyIndustry    String?
  companySize        String?  // "1-10" | "11-50" | etc.
  companyLocation    String?
  companyDescription String?
  companyFounded     String?  // year as string (free-form)
  lastLoginAt   DateTime?
  newsletterSubscribed   Boolean   @default(false)
  newsletterSubscribedAt DateTime?
  /// Three-state intent declared at signup:
  ///   "subscribe" — wants to be added (default UI choice)
  ///   "no"        — not interested
  ///   "already"   — already on the BioHubNet list
  /// Admins use this to filter the "new opt-ins to export" view.
  newsletterStatus       String    @default("no")
  /// When an admin last copied this user to the clipboard from
  /// /admin/newsletter. Null = not yet exported. Filtered against this
  /// to only show new sign-ups in the export view.
  newsletterExportedAt   DateTime?
  /// Account category: "real" | "sandbox" | "demo".
  ///   sandbox — admin's personal play pair (one employer + one trainee
  ///             per admin). Never auto-deletes.
  ///   demo    — time-limited demo workspace claimed by a prospective
  ///             partner. Cleaned up when demoExpiresAt < NOW().
  /// All admin counts and stats default to filtering for "real" only.
  accountKind            String    @default("real")
  /// Set on demo accounts; the cleanup sweeper deletes the user + all
  /// owned rows once this passes. Null on real and sandbox accounts.
  demoExpiresAt          DateTime?
  /// Set on sandbox + demo accounts; tracks the admin who minted them
  /// so the admin sees their own sandboxes first in the panel.
  createdByAdminId       String?
  createdByAdmin         User?     @relation("CreatedSandboxes", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdSandboxes       User[]    @relation("CreatedSandboxes")
  /// Bearer-token magic link for sandbox + demo accounts only. Anyone
  /// holding this token can sign in as the user via /sandbox/[token].
  /// Real accounts have null here — the route refuses to issue a JWT
  /// for accountKind="real" even if a token were somehow set, so a leak
  /// can never escalate to a real-user takeover.
  magicToken             String?   @unique
  /// Email-verification token (distinct from magicToken so revoking
  /// one doesn't disturb the other). Set on register, cleared when
  /// the user clicks the verification link. emailVerifyExpires gates
  /// reuse — typically 7 days from issue.
  emailVerifyToken       String?   @unique
  emailVerifyExpires     DateTime?
  /// Trainee-facing "My Application" artifacts. Stored on the user
  /// so they survive across talent-application submissions; the
  /// trainee manages them from /profile/application.
  resumeUrl              String?
  videoIntroUrl          String?
  elevatorPitch          String?
  applicationUpdatedAt   DateTime?
  /// Onboarding progress: { version, seenStepIds[], minimized, dismissed, completedAt }
  onboarding    Json?
  /// GDPR/CCPA consent: { necessary, analytics, marketing, version, acceptedAt }
  consent       Json?
  /// Preferred UI language ISO code: en | es | fr | zh
  locale        String    @default("en")
  phone         String?
  bio           String?
  organization  String?
  jobTitle      String?
  country       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  enrollments        Enrollment[]
  scormSessions      ScormSession[]
  xapiStatements     XapiStatement[]
  certificates       Certificate[]
  instructedCourses  Course[]          @relation("Instructor")
  assessmentAttempts AssessmentAttempt[]
  creditTransactions CreditTransaction[]
  groupMemberships   GroupMembership[]
  auditLogs          AuditLog[]
  creditApplications CreditApplication[]   @relation("Applicant")
  reviewedApplications CreditApplication[] @relation("Reviewer")
  roleRequests       RoleChangeRequest[]   @relation("RoleRequester")
  reviewedRoleRequests RoleChangeRequest[] @relation("RoleReviewer")
  buddiesInitiated   BuddyPair[]           @relation("InitiatorBuddies")
  buddiesPartnered   BuddyPair[]           @relation("PartnerBuddies")
  buddyMessages      BuddyMessage[]        @relation("BuddyMessageSender")

  // Phase 1–5 additions
  skills              UserSkill[]
  applicationStatuses ApplicationStatus[]   @relation("Applicant")
  statusEdits         ApplicationStatus[]   @relation("StatusEditor")
  interviews          Interview[]           @relation("Interviewee")
  scheduledInterviews Interview[]           @relation("Interviewer")
  accessRequestsHandled AccessRequest[]     @relation("AccessRequestHandler")
  formSubmissions     EventFormSubmission[] @relation("FormSubmitter")
  savedPostings       UserSavedPosting[]    @relation("SavedPostingUser")
  reviewBookmarks     ReviewBookmark[]

  @@index([newsletterStatus, newsletterExportedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

/// Short-lived 6-digit codes emailed to users for passwordless login.
/// codeHash is bcrypt; we never store the plaintext. Single-use — the
/// row is deleted on successful verification. attempts caps brute force.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

/// Editable registration / signup forms. The `fields` JSON stores an
/// array of FormField objects (see src/lib/forms/types.ts). Admins can
/// edit labels / required-flags / options without a migration.
model EventForm {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  description String?
  fields      Json
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  submissions EventFormSubmission[]
}

/// One-time invite issued by an admin so an Employer HR partner can
/// self-sign-up and land directly on the employer role. The token is a
/// long random string; the recipient hits /signup/employer/[token] to
/// claim. Used invites stay around for the audit trail.
model EmployerInvite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  /// Optional: company name pre-filled at claim time.
  companyName String?
  /// Optional: company website pre-filled at claim time.
  companyWebsite String?
  invitedById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  /// Phase 6 demo-mode: read-only preview link admins can hand to a
  /// prospective partner so they can browse the portal before committing.
  demoMode    Boolean   @default(false)
  /// Each magic-link click bumps these. Useful for the admin's
  /// "did they open the link" signal.
  openCount    Int      @default(0)
  lastOpenedAt DateTime?

  @@index([email])
  @@index([invitedById, createdAt])
}

/// Public access-request inbox. The /for-employers and /for-trainees
/// marketing pages let visitors leave their email; admins triage from
/// /admin/access-requests and approve into an EmployerInvite or a
/// trainee welcome.
model AccessRequest {
  id          String   @id @default(cuid())
  kind        String   // "employer" | "trainee"
  email       String
  name        String?
  company     String?
  website     String?
  message     String?
  source      String   @default("for-employers")
  status      String   @default("pending") // pending | approved | rejected
  handledAt   DateTime?
  handledById String?
  handledBy   User?    @relation("AccessRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([kind])
}

/// Skill ontology — every Course, InternshipPosting, and User attaches
/// to canonical Skill rows so the matching engine can reason about a
/// shared vocabulary instead of free strings.
model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String?
  description String?
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding   Unsupported("vector(384)")?
  status      String   @default("active") // active | deprecated | merged
  mergedIntoId String?
  mergedInto   Skill?  @relation("SkillMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Skill[] @relation("SkillMerge")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  aliases       SkillAlias[]
  courses       CourseSkill[]
  users         UserSkill[]
  postings      PostingSkill[]

  @@index([status])
  @@index([category])
}

model SkillAlias {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  alias     String   @unique
  createdAt DateTime @default(now())

  @@index([skillId])
}

model CourseSkill {
  id         String   @id @default(cuid())
  courseId   String
  skillId    String
  weight     Float    @default(0.5)
  source     String   @default("ai")  // ai | admin | seed
  confidence Float?
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
  @@index([skillId])
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     Float    @default(0.5)
  source    String   @default("inferred") // self | resume | ai | inferred | admin
  /// JSON: { courseIds?: string[], resumeLine?: string, note?: string }
  evidence  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model PostingSkill {
  id         String   @id @default(cuid())
  postingId  String
  skillId    String
  weight     Float    @default(0.5)
  required   Boolean  @default(true)
  source     String   @default("ai") // ai | admin | employer
  confidence Float?
  createdAt  DateTime @default(now())
  posting    InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([postingId, skillId])
  @@index([skillId])
}

/// Phase 4 kanban: tracks an applicant's status per posting. One row
/// per (postingId, applicantId) — created lazily when the employer
/// first interacts with the application.
model ApplicationStatus {
  id          String   @id @default(cuid())
  postingId   String
  applicantId String
  status      String   @default("new") // new | reviewing | shortlisted | phone_screen | onsite | offer | hired | rejected | closed
  notes       String?
  rating      Int?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posting   InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applicant User              @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  updatedBy User?             @relation("StatusEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([postingId, applicantId])
  @@index([status])
}

/// Phase 5 interview scheduling. Lightweight: employer proposes time
/// slots, applicant accepts one. No external calendar integration in v1.
model Interview {
  id            String   @id @default(cuid())
  postingId     String
  applicantId   String
  scheduledById String
  proposedSlots Json     // ISO[] strings
  acceptedSlot  DateTime?
  status        String   @default("proposed") // proposed | accepted | declined | completed | cancelled
  format        String?  // phone | video | onsite
  location      String?
  notes         String?
  respondedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  posting     InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applicant   User              @relation("Interviewee", fields: [applicantId], references: [id], onDelete: Cascade)
  scheduledBy User              @relation("Interviewer", fields: [scheduledById], references: [id], onDelete: Cascade)

  @@index([postingId])
  @@index([applicantId])
  @@index([status])
}

/// Admin-editable list of options that drives the Course catalog
/// filter rail. Seeded from src/lib/courses/filters.ts on first /courses
/// hit (idempotent); admins can add / rename / hide afterwards.
model CourseFilterOption {
  id        String   @id @default(cuid())
  /// "topic" | "delivery" | "provider"
  type      String
  value     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([type, value])
  @@index([type, sortOrder])
}

/// Internship / job-board posting. Admins create either by filling
/// fields manually or by pasting a job description and letting the
/// AI parser pre-fill the form.
model InternshipPosting {
  id              String    @id @default(cuid())
  companyName     String
  website         String?
  title           String
  duration        String?
  hours           String?
  location        String?
  type            String?
  compensation    String?
  deadline        DateTime?
  keySkills       String[]
  positionDetails String
  /// "active" | "closed" | "draft"
  status          String    @default("active")
  /// Apply-direct contact. Email is the primary target; name + phone
  /// are optional. Trainees see these on the posting detail page so
  /// they can email a tailored pitch directly to the hiring contact.
  contactEmail    String?
  contactName     String?
  contactPhone    String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Phase 1–5 additions
  skills              PostingSkill[]
  applicationStatuses ApplicationStatus[]
  interviews          Interview[]
  saves               UserSavedPosting[]

  @@index([status, createdAt])
}

/// Trainee bookmarks. Lets a trainee mark postings they want to come
/// back to — deadline tracking, comparison, "apply later" reminder.
/// Surfaced at /profile/applications under the "Saved" tab and via
/// a heart icon on each posting card.
model UserSavedPosting {
  id        String   @id @default(cuid())
  userId    String
  postingId String
  createdAt DateTime @default(now())

  user    User              @relation("SavedPostingUser", fields: [userId], references: [id], onDelete: Cascade)
  posting InternshipPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  @@unique([userId, postingId])
  @@index([userId, createdAt])
}

/// Individual answer set for an EventForm. `data` is keyed by field id.
model EventFormSubmission {
  id        String    @id @default(cuid())
  formId    String
  form      EventForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      Json
  email     String?
  userId    String?
  /// Optional FK to User — set null if the user is deleted; submissions
  /// outlive accounts so we keep the row but lose the link.
  user      User?     @relation("FormSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([formId, createdAt])
  @@index([email])
  @@index([userId])
}

model Course {
  id           String   @id @default(cuid())
  title        String
  description  String?
  thumbnail    String?
  category     String?
  tags         String?
  status       String   @default("draft")
  courseType   String   @default("scorm")
  passingScore Float    @default(80)
  maxAttempts  Int      @default(0)
  duration     Int?
  creditCost   Float    @default(0)
  // Catalog filter facets — see src/lib/courses/filters.ts for the
  // canonical option lists. Free-text so admins can extend later.
  topic        String?  // e.g. "Regulatory Affairs"
  delivery     String?  // "Asynchronous" | "Online" | "In-Person" | "Blended"
  provider     String?  // e.g. "CASTL", "BioTalent Canada"
  isSpecial    Boolean  @default(false)  // Special Programs / Workshops flag
  instructorId String?
  instructor   User?    @relation("Instructor", fields: [instructorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // AI-generated summary of the course (visible to learners; refreshable by staff).
  aiSummary    String?
  embeddedAt   DateTime?
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding    Unsupported("vector(384)")?

  scormPackage ScormPackage?
  modules      Module[]
  enrollments  Enrollment[]
  assessments  Assessment[]
  certificates Certificate[]
  groupCourses GroupCourse[]
  pathways     PathwayCourse[]
  skills       CourseSkill[]
}

model ScormPackage {
  id           String   @id @default(cuid())
  courseId     String   @unique
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version      String
  entryPoint   String
  manifestData String
  uploadPath   String
  uploadedAt   DateTime @default(now())
  sessions     ScormSession[]
}

model ScormSession {
  id            String   @id @default(cuid())
  userId        String
  packageId     String
  attemptNumber Int      @default(1)
  status        String   @default("not attempted")
  score         Float?
  scoreMin      Float?
  scoreMax      Float?
  timeSpent     String?
  location      String?
  suspendData   String?
  interactions  String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  type        String   @default("content")
  content     String?
  videoUrl    String?
  fileUrl     String?
  duration    Int?
  isRequired  Boolean  @default(true)
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    ModuleProgress[]
  checkpoints ModuleCheckpoint[]
}

model ModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  status      String   @default("not_started")
  score       Float?
  timeSpent   Int?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([userId, moduleId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  status      String    @default("active")
  score       Float?
  progress    Float     @default(0)
  attempts    Int       @default(0)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  dueDate     DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

model Assessment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  timeLimit   Int?
  passingScore Float   @default(80)
  maxAttempts Int      @default(0)
  shuffleQ    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  AssessmentAttempt[]
}

model Question {
  id            String   @id @default(cuid())
  assessmentId  String
  text          String
  type          String
  options       String?
  correctAnswer String?
  points        Float    @default(1)
  order         Int
  explanation   String?
  /// Free-text topic label for the mastery heatmap. Author-supplied
  /// — no separate KC ontology yet. Items without a topic fall under
  /// the assessment title in the heatmap aggregation.
  topic         String?
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  bookmarks     ReviewBookmark[]
  checkpoints   ModuleCheckpoint[]
}

/// Trainee-bookmarked questions. Light spaced-repetition: nextReviewAt
/// driven by an expanding-interval ladder (1 → 3 → 7 → 14 → 30 days)
/// gated by self-graded binary quality ("got it" / "still tricky").
/// Auto-generation is deferred — only questions the trainee
/// deliberately bookmarks are scheduled.
model ReviewBookmark {
  id             String    @id @default(cuid())
  userId         String
  questionId     String
  intervalDays   Int       @default(1)
  nextReviewAt   DateTime
  lastReviewedAt DateTime?
  /// 0 = "still tricky" (resets ladder), 1 = "got it" (advances).
  lastQuality    Int?
  createdAt      DateTime  @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

/// Author-placed checkpoint inside a video module. Pauses playback at
/// `timestampSeconds` and (optionally) presents a comprehension
/// question. When `questionId` is null the player just shows a
/// "checkpoint" pause card with a Continue button.
model ModuleCheckpoint {
  id               String   @id @default(cuid())
  moduleId         String
  timestampSeconds Float
  questionId       String?
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())
  module   Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  @@index([moduleId, orderIndex])
}

model AssessmentAttempt {
  id           String    @id @default(cuid())
  assessmentId String
  userId       String
  score        Float?
  maxScore     Float?
  passed       Boolean?
  answers      String
  timeSpent    Int?
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XapiStatement {
  id          String   @id @default(cuid())
  statementId String   @unique
  userId      String
  verb        String
  object      String
  result      String?
  context     String?
  timestamp   DateTime @default(now())
  stored      DateTime @default(now())
  authority   String?
  version     String   @default("1.0.3")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LtiConfig {
  id            String   @id @default(cuid())
  name          String
  issuer        String
  clientId      String
  authEndpoint  String
  tokenEndpoint String
  jwksEndpoint  String
  deploymentId  String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Certificate {
  id         String    @id @default(cuid())
  userId     String
  courseId   String?
  pathwayId  String?
  kind       String    @default("course") // course | pathway
  issueDate  DateTime  @default(now())
  expiryDate DateTime?
  metadata   String?
  pdfUrl     String?
  revokedAt  DateTime?
  revokedBy  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pathway    Pathway?  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
  @@unique([userId, pathwayId])
}

model Pathway {
  id           String   @id @default(cuid())
  title        String
  description  String?
  thumbnail    String?
  category     String?
  status       String   @default("draft") // draft | published
  creditCost   Float    @default(0)
  createdById  String?
  embeddedAt   DateTime?
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding    Unsupported("vector(384)")?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Enrollment management
  enrollmentStatus    String    @default("open")   // open | closed | full
  enrollmentOpensAt   DateTime?
  enrollmentClosesAt  DateTime?
  capacity            Int?
  allowWaitlist       Boolean   @default(true)

  courses      PathwayCourse[]
  enrollments  PathwayEnrollment[]
  certificates Certificate[]
}

model PathwayCourse {
  id        String  @id @default(cuid())
  pathwayId String
  courseId  String
  order     Int     @default(0)
  required  Boolean @default(true)
  pathway   Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([pathwayId, courseId])
}

model PathwayEnrollment {
  id          String    @id @default(cuid())
  userId      String
  pathwayId   String
  // pending | approved | rejected | waitlisted | withdrawn | completed
  status        String    @default("pending")
  requestReason String?
  reviewerId    String?
  reviewerNote  String?
  reviewedAt    DateTime?
  enrolledAt    DateTime  @default(now())  // request created
  approvedAt    DateTime?
  completedAt   DateTime?
  pathway       Pathway   @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([userId, pathwayId])
  @@index([pathwayId, status, enrolledAt])
}

/// Application from a trainee for additional starter credits beyond the
/// 200 granted at registration. Reviewed manually by admin staff.
model CreditApplication {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("pending")  // pending | approved | rejected
  requestedAmount Float   @default(4800)
  approvedAmount  Float?
  fullName      String
  organization  String?
  title         String?
  country       String?
  phone         String?
  useCase       String     // why they need the credits
  documents     Json       // array of { key, name, size, contentType }
  reviewerId    String?
  reviewerNote  String?
  reviewedAt    DateTime?
  submittedAt   DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user      User  @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("Reviewer",  fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([userId, submittedAt])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String   // credit | debit
  reason      String   // enrollment | refund | admin_grant | initial
  courseId    String?
  balanceAfter Float
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  GroupMembership[]
  courses  GroupCourse[]
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  addedAt   DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}

model GroupCourse {
  id       String @id @default(cuid())
  groupId  String
  courseId String
  addedAt  DateTime @default(now())
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([groupId, courseId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  courseId  String?
  authorId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // user.create | user.deactivate | course.publish | enrollment.create | credit.grant …
  targetType String?  // user | course | enrollment | certificate
  targetId   String?
  detail     String?  // JSON
  ip         String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

/// Audit + cost log for every AI call (chat, embed, summarize, search,
/// tutor). Powers the AI section of the analytics dashboard.
model AIInteraction {
  id               String   @id @default(cuid())
  userId           String?
  kind             String   // chat | embed | summarize | search | tutor | classify
  provider         String   // cloudflare | gemini
  model            String
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  success          Boolean  @default(true)
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

/// Persistent cache of m2m100 (and any future translation model)
/// outputs. Keyed by a sha256 of `model:sourceLang:targetLang:sourceText`
/// so the same string is only translated once across the whole platform.
/// The model field is part of the hash, so swapping engines invalidates.
model Translation {
  id             String   @id @default(cuid())
  hash           String   @unique
  sourceLang     String
  targetLang     String
  sourceText     String
  translatedText String
  model          String   // e.g. "m2m100-1.2b"
  createdAt      DateTime @default(now())

  @@index([targetLang])
}

/// GDPR / CCPA data-subject request log. Used to record exports and
/// deletion requests with timestamps so we can prove compliance later.
model DataSubjectRequest {
  id          String   @id @default(cuid())
  userId      String
  kind        String   // export | delete | rectify
  status      String   @default("completed")  // completed | pending | rejected
  detail      String?  // free text — what was requested or done
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Two-person learning buddy relationship. Either side can end it at any
/// time. Pairs are unique per (initiator, partner); a 'reverse' invite
/// from the partner reuses the same row by flipping who initiated.
model BuddyPair {
  id           String   @id @default(cuid())
  initiatorId  String
  partnerId    String
  status       String   @default("invited")  // invited | active | declined | ended
  focusType    String?  // course | pathway | open
  focusId      String?
  goalNote     String?
  invitedAt    DateTime @default(now())
  acceptedAt   DateTime?
  endedAt      DateTime?
  endedById    String?

  initiator User @relation("InitiatorBuddies", fields: [initiatorId], references: [id], onDelete: Cascade)
  partner   User @relation("PartnerBuddies",   fields: [partnerId],   references: [id], onDelete: Cascade)
  messages  BuddyMessage[]

  @@unique([initiatorId, partnerId])
  @@index([partnerId, status])
  @@index([initiatorId, status])
}

/// Async messages between buddies — tied to a pair. Optionally anchored
/// to a course/module/pathway via refType+refId for deep-link context.
model BuddyMessage {
  id        String    @id @default(cuid())
  pairId    String
  senderId  String
  body      String
  refType   String?   // course | pathway | module
  refId     String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  pair   BuddyPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  sender User      @relation("BuddyMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([pairId, createdAt])
}

/// User-initiated request to change their own role. Admins review and
/// approve or reject; on approval, the user's role is updated.
model RoleChangeRequest {
  id           String    @id @default(cuid())
  userId       String
  fromRole     String
  toRole       String
  reason       String?
  status       String    @default("pending")  // pending | approved | rejected
  reviewerId   String?
  reviewerNote String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User  @relation("RoleRequester", fields: [userId],     references: [id], onDelete: Cascade)
  reviewer User? @relation("RoleReviewer",  fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// User activity events. Lightweight, append-only audit of behavior used
/// to power the analytics dashboard and UX research. Distinct from AuditLog
/// (which records sensitive admin actions) and XapiStatement (which records
/// formal SCORM/xAPI learning statements).
model Event {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  name       String   // page_view | course_view | enroll | scorm_start | scorm_complete | theme_change | login | register | search | feature_use
  path       String?
  referrer   String?
  props      Json?
  role       String?  // snapshot of role at event time
  device     String?  // desktop | mobile | tablet
  country    String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([userId, createdAt])
}

/// Public release / what's-new feed. Each entry's audience is controlled
/// by the visibleTo array — roles in this list will see the entry on the
/// /changelog page (trainees see it as "What's new", staff as "Change log").
model ChangeLog {
  id          String   @id @default(cuid())
  title       String
  body        String
  kind        String   @default("feature")  // feature | fix | improvement | note
  version     String?
  /// Build commit SHA the entry first shipped on. Populated from
  /// NEXT_PUBLIC_COMMIT_SHA at create time. Surfaced only to
  /// admin / superadmin on the changelog page.
  buildSha    String?
  visibleTo   String[] @default(["trainee", "evaluating", "instructor", "admin", "superadmin"])
  publishedAt DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
