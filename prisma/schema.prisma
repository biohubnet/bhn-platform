generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Roles: user | admin | superadmin | evaluating
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("trainee") // trainee | evaluating | instructor | admin | superadmin
  isActive      Boolean   @default(true)
  credits       Float     @default(200)
  lastLoginAt   DateTime?
  newsletterSubscribed   Boolean   @default(false)
  newsletterSubscribedAt DateTime?
  /// Onboarding progress: { version, seenStepIds[], minimized, dismissed, completedAt }
  onboarding    Json?
  /// GDPR/CCPA consent: { necessary, analytics, marketing, version, acceptedAt }
  consent       Json?
  /// Preferred UI language ISO code: en | es | fr | zh
  locale        String    @default("en")
  phone         String?
  bio           String?
  organization  String?
  jobTitle      String?
  country       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  enrollments        Enrollment[]
  scormSessions      ScormSession[]
  xapiStatements     XapiStatement[]
  certificates       Certificate[]
  instructedCourses  Course[]          @relation("Instructor")
  assessmentAttempts AssessmentAttempt[]
  creditTransactions CreditTransaction[]
  groupMemberships   GroupMembership[]
  auditLogs          AuditLog[]
  creditApplications CreditApplication[]   @relation("Applicant")
  reviewedApplications CreditApplication[] @relation("Reviewer")
  roleRequests       RoleChangeRequest[]   @relation("RoleRequester")
  reviewedRoleRequests RoleChangeRequest[] @relation("RoleReviewer")
  buddiesInitiated   BuddyPair[]           @relation("InitiatorBuddies")
  buddiesPartnered   BuddyPair[]           @relation("PartnerBuddies")
  buddyMessages      BuddyMessage[]        @relation("BuddyMessageSender")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Course {
  id           String   @id @default(cuid())
  title        String
  description  String?
  thumbnail    String?
  category     String?
  tags         String?
  status       String   @default("draft")
  courseType   String   @default("scorm")
  passingScore Float    @default(80)
  maxAttempts  Int      @default(0)
  duration     Int?
  creditCost   Float    @default(0)
  instructorId String?
  instructor   User?    @relation("Instructor", fields: [instructorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // AI-generated summary of the course (visible to learners; refreshable by staff).
  aiSummary    String?
  embeddedAt   DateTime?
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding    Unsupported("vector(384)")?

  scormPackage ScormPackage?
  modules      Module[]
  enrollments  Enrollment[]
  assessments  Assessment[]
  certificates Certificate[]
  groupCourses GroupCourse[]
  pathways     PathwayCourse[]
}

model ScormPackage {
  id           String   @id @default(cuid())
  courseId     String   @unique
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version      String
  entryPoint   String
  manifestData String
  uploadPath   String
  uploadedAt   DateTime @default(now())
  sessions     ScormSession[]
}

model ScormSession {
  id            String   @id @default(cuid())
  userId        String
  packageId     String
  attemptNumber Int      @default(1)
  status        String   @default("not attempted")
  score         Float?
  scoreMin      Float?
  scoreMax      Float?
  timeSpent     String?
  location      String?
  suspendData   String?
  interactions  String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  type        String   @default("content")
  content     String?
  videoUrl    String?
  fileUrl     String?
  duration    Int?
  isRequired  Boolean  @default(true)
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress ModuleProgress[]
}

model ModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  status      String   @default("not_started")
  score       Float?
  timeSpent   Int?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([userId, moduleId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  status      String    @default("active")
  score       Float?
  progress    Float     @default(0)
  attempts    Int       @default(0)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  dueDate     DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

model Assessment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  timeLimit   Int?
  passingScore Float   @default(80)
  maxAttempts Int      @default(0)
  shuffleQ    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  AssessmentAttempt[]
}

model Question {
  id            String   @id @default(cuid())
  assessmentId  String
  text          String
  type          String
  options       String?
  correctAnswer String?
  points        Float    @default(1)
  order         Int
  explanation   String?
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AssessmentAttempt {
  id           String    @id @default(cuid())
  assessmentId String
  userId       String
  score        Float?
  maxScore     Float?
  passed       Boolean?
  answers      String
  timeSpent    Int?
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model XapiStatement {
  id          String   @id @default(cuid())
  statementId String   @unique
  userId      String
  verb        String
  object      String
  result      String?
  context     String?
  timestamp   DateTime @default(now())
  stored      DateTime @default(now())
  authority   String?
  version     String   @default("1.0.3")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LtiConfig {
  id            String   @id @default(cuid())
  name          String
  issuer        String
  clientId      String
  authEndpoint  String
  tokenEndpoint String
  jwksEndpoint  String
  deploymentId  String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Certificate {
  id         String    @id @default(cuid())
  userId     String
  courseId   String?
  pathwayId  String?
  kind       String    @default("course") // course | pathway
  issueDate  DateTime  @default(now())
  expiryDate DateTime?
  metadata   String?
  pdfUrl     String?
  revokedAt  DateTime?
  revokedBy  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pathway    Pathway?  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
  @@unique([userId, pathwayId])
}

model Pathway {
  id           String   @id @default(cuid())
  title        String
  description  String?
  thumbnail    String?
  category     String?
  status       String   @default("draft") // draft | published
  creditCost   Float    @default(0)
  createdById  String?
  embeddedAt   DateTime?
  /// 384-d BGE-small embedding; managed via raw SQL (pgvector).
  embedding    Unsupported("vector(384)")?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Enrollment management
  enrollmentStatus    String    @default("open")   // open | closed | full
  enrollmentOpensAt   DateTime?
  enrollmentClosesAt  DateTime?
  capacity            Int?
  allowWaitlist       Boolean   @default(true)

  courses      PathwayCourse[]
  enrollments  PathwayEnrollment[]
  certificates Certificate[]
}

model PathwayCourse {
  id        String  @id @default(cuid())
  pathwayId String
  courseId  String
  order     Int     @default(0)
  required  Boolean @default(true)
  pathway   Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([pathwayId, courseId])
}

model PathwayEnrollment {
  id          String    @id @default(cuid())
  userId      String
  pathwayId   String
  // pending | approved | rejected | waitlisted | withdrawn | completed
  status        String    @default("pending")
  requestReason String?
  reviewerId    String?
  reviewerNote  String?
  reviewedAt    DateTime?
  enrolledAt    DateTime  @default(now())  // request created
  approvedAt    DateTime?
  completedAt   DateTime?
  pathway       Pathway   @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([userId, pathwayId])
  @@index([pathwayId, status, enrolledAt])
}

/// Application from a trainee for additional starter credits beyond the
/// 200 granted at registration. Reviewed manually by admin staff.
model CreditApplication {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("pending")  // pending | approved | rejected
  requestedAmount Float   @default(4800)
  approvedAmount  Float?
  fullName      String
  organization  String?
  title         String?
  country       String?
  phone         String?
  useCase       String     // why they need the credits
  documents     Json       // array of { key, name, size, contentType }
  reviewerId    String?
  reviewerNote  String?
  reviewedAt    DateTime?
  submittedAt   DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user      User  @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("Reviewer",  fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([userId, submittedAt])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String   // credit | debit
  reason      String   // enrollment | refund | admin_grant | initial
  courseId    String?
  balanceAfter Float
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  GroupMembership[]
  courses  GroupCourse[]
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  addedAt   DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}

model GroupCourse {
  id       String @id @default(cuid())
  groupId  String
  courseId String
  addedAt  DateTime @default(now())
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([groupId, courseId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  courseId  String?
  authorId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // user.create | user.deactivate | course.publish | enrollment.create | credit.grant …
  targetType String?  // user | course | enrollment | certificate
  targetId   String?
  detail     String?  // JSON
  ip         String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

/// Audit + cost log for every AI call (chat, embed, summarize, search,
/// tutor). Powers the AI section of the analytics dashboard.
model AIInteraction {
  id               String   @id @default(cuid())
  userId           String?
  kind             String   // chat | embed | summarize | search | tutor | classify
  provider         String   // cloudflare | gemini
  model            String
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  success          Boolean  @default(true)
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

/// Persistent cache of m2m100 (and any future translation model)
/// outputs. Keyed by a sha256 of `model:sourceLang:targetLang:sourceText`
/// so the same string is only translated once across the whole platform.
/// The model field is part of the hash, so swapping engines invalidates.
model Translation {
  id             String   @id @default(cuid())
  hash           String   @unique
  sourceLang     String
  targetLang     String
  sourceText     String
  translatedText String
  model          String   // e.g. "m2m100-1.2b"
  createdAt      DateTime @default(now())

  @@index([targetLang])
}

/// GDPR / CCPA data-subject request log. Used to record exports and
/// deletion requests with timestamps so we can prove compliance later.
model DataSubjectRequest {
  id          String   @id @default(cuid())
  userId      String
  kind        String   // export | delete | rectify
  status      String   @default("completed")  // completed | pending | rejected
  detail      String?  // free text — what was requested or done
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Two-person learning buddy relationship. Either side can end it at any
/// time. Pairs are unique per (initiator, partner); a 'reverse' invite
/// from the partner reuses the same row by flipping who initiated.
model BuddyPair {
  id           String   @id @default(cuid())
  initiatorId  String
  partnerId    String
  status       String   @default("invited")  // invited | active | declined | ended
  focusType    String?  // course | pathway | open
  focusId      String?
  goalNote     String?
  invitedAt    DateTime @default(now())
  acceptedAt   DateTime?
  endedAt      DateTime?
  endedById    String?

  initiator User @relation("InitiatorBuddies", fields: [initiatorId], references: [id], onDelete: Cascade)
  partner   User @relation("PartnerBuddies",   fields: [partnerId],   references: [id], onDelete: Cascade)
  messages  BuddyMessage[]

  @@unique([initiatorId, partnerId])
  @@index([partnerId, status])
  @@index([initiatorId, status])
}

/// Async messages between buddies — tied to a pair. Optionally anchored
/// to a course/module/pathway via refType+refId for deep-link context.
model BuddyMessage {
  id        String    @id @default(cuid())
  pairId    String
  senderId  String
  body      String
  refType   String?   // course | pathway | module
  refId     String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  pair   BuddyPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  sender User      @relation("BuddyMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([pairId, createdAt])
}

/// User-initiated request to change their own role. Admins review and
/// approve or reject; on approval, the user's role is updated.
model RoleChangeRequest {
  id           String    @id @default(cuid())
  userId       String
  fromRole     String
  toRole       String
  reason       String?
  status       String    @default("pending")  // pending | approved | rejected
  reviewerId   String?
  reviewerNote String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User  @relation("RoleRequester", fields: [userId],     references: [id], onDelete: Cascade)
  reviewer User? @relation("RoleReviewer",  fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// User activity events. Lightweight, append-only audit of behavior used
/// to power the analytics dashboard and UX research. Distinct from AuditLog
/// (which records sensitive admin actions) and XapiStatement (which records
/// formal SCORM/xAPI learning statements).
model Event {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  name       String   // page_view | course_view | enroll | scorm_start | scorm_complete | theme_change | login | register | search | feature_use
  path       String?
  referrer   String?
  props      Json?
  role       String?  // snapshot of role at event time
  device     String?  // desktop | mobile | tablet
  country    String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([userId, createdAt])
}

/// Public release / what's-new feed. Each entry's audience is controlled
/// by the visibleTo array — roles in this list will see the entry on the
/// /changelog page (trainees see it as "What's new", staff as "Change log").
model ChangeLog {
  id          String   @id @default(cuid())
  title       String
  body        String
  kind        String   @default("feature")  // feature | fix | improvement | note
  version     String?
  visibleTo   String[] @default(["trainee", "evaluating", "instructor", "admin", "superadmin"])
  publishedAt DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
