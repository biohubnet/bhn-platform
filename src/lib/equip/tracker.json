{"html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>EQUIP Programme — Recipient Dossier</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;450;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --bg:#0d1014;          /* deep charcoal */\n    --bg-2:#11151b;\n    --card:#151a21;        /* panel */\n    --card-2:#1a2129;\n    --ink:#e8ebef;         /* primary text */\n    --ink-2:#aab2bd;\n    --muted:#727c89;       /* labels */\n    --rule:#222932;        /* hairline */\n    --rule-2:#2c343f;\n    --accent:#4cc2a6;      /* teal-green */\n    --accent-dim:#2f7a68;\n    --vc:#6f9bdb;          /* steel blue */\n    --vl:#54c193;          /* green */\n    --both:#d6a44e;        /* amber */\n    --gold:#e3b65a;        /* highlight ink */\n    --gold-wash:rgba(227,182,90,.07);\n    --gold-rule:#7a6230;\n    --sans:\"IBM Plex Sans\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;\n    --mono:\"IBM Plex Mono\",ui-monospace,Menlo,Consolas,monospace;\n  }\n  *{box-sizing:border-box}\n  html{-webkit-text-size-adjust:100%}\n  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);\n    font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased;\n    background-image:radial-gradient(rgba(255,255,255,.022) 0.5px,transparent 0.5px);background-size:24px 24px}\n  .wrap{max-width:1180px;margin:0 auto;padding:0 34px}\n  a{color:inherit}\n  .ovl{font-family:var(--mono);font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--muted)}\n\n  /* masthead */\n  header.mast{padding:52px 0 28px;border-bottom:1px solid var(--rule-2)}\n  .mast .ovl{display:flex;gap:14px;align-items:center}\n  .mast .ovl::after{content:\"\";flex:1;height:1px;background:var(--rule)}\n  h1{font-weight:600;font-size:clamp(30px,5.2vw,50px);line-height:1.04;letter-spacing:-.025em;margin:20px 0 0}\n  h1 .em{color:var(--accent)}\n  .lede{margin:16px 0 0;max-width:680px;color:var(--ink-2);font-size:15.5px}\n  .lede b{font-weight:600;color:var(--ink)}\n  .standfirst{display:flex;flex-wrap:wrap;align-items:baseline;gap:18px;margin-top:24px}\n  .stamp{font-family:var(--mono);font-size:12px;color:var(--muted)}\n  .stamp b{color:var(--ink);font-weight:500}\n  .rescan{font-family:var(--mono);font-size:12px;letter-spacing:.03em;color:var(--accent);\n    background:none;border:0;border-bottom:1px solid var(--accent-dim);padding:2px 1px;cursor:pointer;transition:.15s}\n  .rescan:hover{color:var(--ink);border-color:var(--accent)}\n  .rescan.copied{color:var(--gold);border-color:var(--gold-rule)}\n\n  /* ledger */\n  .ledger{display:flex;flex-wrap:wrap;border-bottom:1px solid var(--rule-2)}\n  .led{padding:24px 30px 22px 0;margin-right:30px;border-right:1px solid var(--rule)}\n  .led:last-child{border-right:0}\n  .led .v{font-weight:600;font-size:38px;line-height:1;letter-spacing:-.03em;font-variant-numeric:tabular-nums}\n  .led .k{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:9px}\n  .led.vc .v{color:var(--vc)} .led.vl .v{color:var(--vl)} .led.both .v{color:var(--both)} .led.gold .v{color:var(--gold)}\n  .led.hqp .v{color:var(--accent)}\n\n  /* controls */\n  .controls{position:sticky;top:0;z-index:5;background:rgba(13,16,20,.92);backdrop-filter:blur(8px);\n    display:flex;flex-wrap:wrap;align-items:center;gap:10px 26px;\n    padding:16px 0;border-bottom:1px solid var(--rule-2);margin-bottom:4px}\n  .filters{display:flex;gap:22px}\n  .seg{font-family:var(--mono);font-size:12px;letter-spacing:.05em;text-transform:uppercase;\n    background:none;border:0;color:var(--muted);padding:5px 0;cursor:pointer;position:relative}\n  .seg:hover{color:var(--ink-2)}\n  .seg.active{color:var(--ink)}\n  .seg.active::after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--accent)}\n  .seg .c{font-size:10px;color:var(--muted);margin-left:5px}\n  .spacer{flex:1}\n  .search{display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--rule-2);padding:5px 2px;min-width:220px}\n  .search svg{width:14px;height:14px;color:var(--muted);flex:none}\n  .search input{border:0;outline:0;background:none;font-family:var(--sans);font-size:14px;color:var(--ink);width:100%}\n  .search input::placeholder{color:var(--muted)}\n  .hl-toggle{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11.5px;\n    letter-spacing:.03em;text-transform:uppercase;color:var(--ink-2);cursor:pointer;user-select:none}\n  .hl-toggle input{position:absolute;opacity:0}\n  .box{width:15px;height:15px;border:1.5px solid var(--rule-2);display:inline-flex;align-items:center;justify-content:center;color:#0d1014;transition:.12s}\n  .hl-toggle input:checked + .box{background:var(--gold);border-color:var(--gold)}\n  .box svg{width:11px;height:11px;opacity:0}\n  .hl-toggle input:checked + .box svg{opacity:1}\n\n  /* grid */\n  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(390px,1fr));gap:0;\n    border-left:1px solid var(--rule);margin:14px 0 60px}\n  .entry{border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);padding:22px 24px 18px;background:var(--card)}\n  .entry:hover{background:var(--card-2)}\n  .e-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}\n  .e-id{display:flex;align-items:center;gap:11px;min-width:0}\n  .logo{position:relative;width:36px;height:36px;border-radius:8px;flex:none;overflow:hidden;\n    display:flex;align-items:center;justify-content:center;background:var(--card-2);border:1px solid var(--rule-2)}\n  .logo .mono{font-family:var(--mono);font-weight:600;font-size:15px;color:var(--accent)}\n  .logo img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#fff;padding:3px;opacity:0;transition:opacity .2s}\n  .e-name{font-weight:600;font-size:18px;line-height:1.15;letter-spacing:-.015em}\n  .track{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.08em;white-space:nowrap;padding-top:4px}\n  .track.VC{color:var(--vc)} .track.VL{color:var(--vl)} .track.Both{color:var(--both)}\n  .e-meta{font-family:var(--mono);font-size:11.5px;color:var(--muted);margin-top:8px;line-height:1.55}\n  .e-links{display:flex;flex-wrap:wrap;gap:5px 16px;margin-top:12px}\n  .e-links a{font-size:13px;text-decoration:none;border-bottom:1px solid var(--rule-2);padding-bottom:1px;color:var(--accent)}\n  .e-links a:hover{border-color:var(--accent)}\n  .e-links a.web{color:var(--ink-2)}\n  .e-links .dead{font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:.03em}\n  .status{display:flex;align-items:center;gap:8px;margin-top:12px;font-family:var(--mono);font-size:11px;letter-spacing:.02em;color:var(--ink-2)}\n  .pip{width:7px;height:7px;flex:none;transform:rotate(45deg)}\n  .pip.live{background:var(--vl)} .pip.web{background:var(--gold)} .pip.none{background:var(--muted)}\n\n  .feed{margin-top:16px;border-top:1px solid var(--rule)}\n  .f-label{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:13px 0 2px}\n  .post{display:grid;grid-template-columns:14px 1fr;gap:10px;padding:11px 0;border-bottom:1px solid var(--rule)}\n  .post:last-child{border-bottom:0}\n  .post .mk{font-family:var(--mono);color:var(--muted);font-size:12px;line-height:1.5}\n  .post.hl{padding-left:12px;border-left:2px solid var(--gold-rule);margin-left:-14px;background:linear-gradient(90deg,var(--gold-wash),transparent 86%)}\n  .post.hl .mk{color:var(--gold)}\n  .p-text{font-size:13.5px;line-height:1.5;color:var(--ink)}\n  .p-meta{margin-top:6px;display:flex;flex-wrap:wrap;gap:5px 12px;font-family:var(--mono);font-size:11px;color:var(--muted);align-items:center}\n  .p-type{color:var(--ink-2);letter-spacing:.05em;text-transform:uppercase;font-size:10px}\n  .post.hl .p-type{color:var(--gold)}\n  .src{color:var(--accent);text-decoration:none;border-bottom:1px solid var(--accent-dim)}\n  .src:hover{color:var(--ink);border-color:var(--accent)}\n  .src.plain{color:var(--muted);border:0}\n\n  .empty{grid-column:1/-1;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);\n    padding:64px;text-align:center;font-family:var(--mono);font-size:13px;color:var(--muted)}\n\n  @media(max-width:720px){\n    .wrap{padding:0 20px}\n    .grid{grid-template-columns:1fr}\n    .led{padding-right:22px;margin-right:22px}\n    .led .v{font-size:30px}\n  }\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n\n  <header class=\"mast\">\n    <div class=\"ovl\">BioHubNet · EQUIP Programme · Recipient Dossier</div>\n    <h1>Who we funded,<br>and what they&rsquo;re <span class=\"em\">building</span>.</h1>\n    <p class=\"lede\">Every company awarded a <b>VentureConnect&nbsp;(VC)</b> or <b>VentureLift&nbsp;(VL)</b> grant, tracked across LinkedIn and the open web. Marked entries flag a fresh award, raise, partnership or milestone — each links to its source.</p>\n    <div class=\"standfirst\">\n      <span class=\"stamp\">Last rescan&nbsp;&nbsp;<b id=\"stamp\">—</b></span>\n      <button class=\"rescan\" id=\"rescanBtn\">↻ copy rescan prompt</button>\n    </div>\n  </header>\n\n  <section class=\"ledger\" id=\"ledger\"></section>\n\n  <div class=\"controls\">\n    <div class=\"filters\" id=\"segs\">\n      <button class=\"seg active\" data-f=\"all\">All <span class=\"c\" id=\"c-all\"></span></button>\n      <button class=\"seg\" data-f=\"VC\">VentureConnect <span class=\"c\" id=\"c-VC\"></span></button>\n      <button class=\"seg\" data-f=\"VL\">VentureLift <span class=\"c\" id=\"c-VL\"></span></button>\n      <button class=\"seg\" data-f=\"Both\">Both <span class=\"c\" id=\"c-Both\"></span></button>\n    </div>\n    <div class=\"spacer\"></div>\n    <label class=\"search\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m21 21-4.3-4.3\"/></svg>\n      <input id=\"q\" type=\"text\" placeholder=\"Search company, founder, milestone…\">\n    </label>\n    <label class=\"hl-toggle\">\n      <input type=\"checkbox\" id=\"hlOnly\">\n      <span class=\"box\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6 9 17l-5-5\"/></svg></span>\n      Highlights only\n    </label>\n  </div>\n\n  <section class=\"grid\" id=\"grid\"></section>\n\n</div>\n\n<script>\n/* ====================================================================\n   DATA — replace on each manual rescan.\n   track: \"VC\" | \"VL\" | \"Both\"\n   linkedin / website: {label,url} or null\n   posts[]: {when, text, type, hl:boolean, src, url}   url => source link\n==================================================================== */\nconst DATA = __EQUIP_DATA__;\n/* ============================ end DATA ============================ */\n\nconst $ = s => document.querySelector(s);\nlet filter=\"all\", hlOnly=false, query=\"\";\n$(\"#stamp\").textContent = DATA.updated;\n\n/* Logo domains — logos served live from these domains (no downloads). */\nconst DOMAINS = {\n  \"Neuropeutics Inc.\":\"neuropeutics.ca\",\n  \"Fibra Inc.\":\"myfibra.com\",\n  \"Re:pair Genomics\":\"repairgenomics.com\",\n  \"MVT in Silico Corp.\":\"mvtinsilico.ca\",\n  \"HormonaLab\":\"hormonalab.com\",\n  \"CELLECT Laboratories Inc.\":\"cellectlaboratories.com\",\n  \"Heprion Inc.\":\"heprion.com\",\n  \"ThermOcular AI\":\"thermocularai.ca\",\n  \"Sparked Inc.\":\"sparkedscreening.com\",\n  \"HDAX Therapeutics\":\"hdaxtx.com\",\n  \"Synakis\":\"synakis.ca\",\n  \"NewGen Health\":\"newgenhealth.io\",\n  \"Mandel Diagnostics\":\"mandeldiagnostics.com\",\n  \"AlloWide Health Inc\":\"allowidehealth.com\",\n  \"Alpha Biosensing\":\"alphabiosensing.com\",\n  \"NorthMiRs Inc.\":\"northmirs.com\"\n};\nDATA.companies.forEach(c=>c.domain = DOMAINS[c.name] || null);\n\nfunction logoEl(co){\n  const letter = (co.name.replace(/[^A-Za-z]/,\"\").charAt(0)||\"·\").toUpperCase();\n  if(co.domain){\n    return `<span class=\"logo\"><span class=\"mono\">${letter}</span>`+\n      `<img alt=\"\" data-d=\"${co.domain}\" data-s=\"0\" src=\"https://logo.clearbit.com/${co.domain}\" `+\n      `onload=\"this.style.opacity=1\" onerror=\"logoFallback(this)\"></span>`;\n  }\n  return `<span class=\"logo\"><span class=\"mono\">${letter}</span></span>`;\n}\nfunction logoFallback(img){\n  if(img.dataset.s===\"0\"){ img.dataset.s=\"1\"; img.src=\"https://www.google.com/s2/favicons?sz=128&domain=\"+img.dataset.d; }\n  else { img.remove(); }\n}\n\nfunction counts(){\n  const c=DATA.companies;\n  return {all:c.length, VC:c.filter(x=>x.track===\"VC\").length,\n          VL:c.filter(x=>x.track===\"VL\").length, Both:c.filter(x=>x.track===\"Both\").length,\n          // HQP = the named grant recipients themselves (grad students,\n          // postdocs, research associates). A few ventures name two, joined\n          // by \"·\", so split rather than counting one per company.\n          hqp:c.reduce((a,x)=>a+String(x.founder||\"\").split(\"\\u00b7\").filter(s=>s.trim()).length,0),\n          hl:c.reduce((a,x)=>a+x.posts.filter(p=>p.hl).length,0)};\n}\nfunction renderLedger(){\n  const k=counts();\n  const items=[\n    {v:k.all,l:\"Companies funded\",cls:\"\"},\n    {v:k.hqp,l:\"HQP supported\",cls:\"hqp\"},\n    {v:k.VC,l:\"VentureConnect\",cls:\"vc\"},\n    {v:k.VL,l:\"VentureLift\",cls:\"vl\"},\n    {v:k.Both,l:\"Both tracks\",cls:\"both\"},\n    {v:k.hl,l:\"Milestones flagged\",cls:\"gold\"}\n  ];\n  $(\"#ledger\").innerHTML=items.map(i=>`<div class=\"led ${i.cls}\"><div class=\"v\">${i.v}</div><div class=\"k\">${i.l}</div></div>`).join(\"\");\n  [\"all\",\"VC\",\"VL\",\"Both\"].forEach(f=>$(\"#c-\"+f).textContent=k[f]);\n}\nconst trackLabel = t => t===\"Both\" ? \"VC · VL\" : t;\n\nfunction entryHTML(co){\n  let posts = hlOnly ? co.posts.filter(p=>p.hl) : co.posts;\n  const li = co.linkedin&&co.linkedin.url\n    ? `<a href=\"${co.linkedin.url}\" target=\"_blank\" rel=\"noopener\">in/${co.linkedin.label} ↗</a>`\n    : `<span class=\"dead\">— no LinkedIn —</span>`;\n  const web = co.website&&co.website.url\n    ? `<a class=\"web\" href=\"${co.website.url}\" target=\"_blank\" rel=\"noopener\">${co.website.label} ↗</a>`\n    : (co.linkedin ? `` : `<span class=\"dead\">no website</span>`);\n  const feed = posts.length ? posts.map(p=>{\n      const src = p.url\n        ? `<a class=\"src\" href=\"${p.url}\" target=\"_blank\" rel=\"noopener\">${p.src} ↗</a>`\n        : `<span class=\"src plain\">${p.src}</span>`;\n      return `<div class=\"post ${p.hl?'hl':''}\">\n        <div class=\"mk\">${p.hl?'◆':'·'}</div>\n        <div>\n          <div class=\"p-text\">${p.text}</div>\n          <div class=\"p-meta\"><span class=\"p-type\">${p.type}</span><span>${p.when}</span>${src}</div>\n        </div>\n      </div>`;}).join(\"\")\n    : `<div class=\"post\"><div class=\"mk\">·</div><div class=\"p-meta\" style=\"margin:0\">no highlighted items</div></div>`;\n  return `<article class=\"entry\">\n    <div class=\"e-top\">\n      <div class=\"e-id\">${logoEl(co)}<div class=\"e-name\">${co.name}</div></div>\n      <div class=\"track ${co.track}\">${trackLabel(co.track)}</div>\n    </div>\n    <div class=\"e-meta\">${co.rounds}<br>${co.founder} — ${co.inst}</div>\n    <div class=\"e-links\">${li}${web}</div>\n    <div class=\"status\"><span class=\"pip ${co.status}\"></span>${co.statusText}</div>\n    <div class=\"feed\">\n      <div class=\"f-label\">Posts &amp; recognition · ${posts.length}</div>\n      ${feed}\n    </div>\n  </article>`;\n}\nfunction render(){\n  const q=query.trim().toLowerCase();\n  const list=DATA.companies.filter(co=>{\n    if(filter!==\"all\" && co.track!==filter) return false;\n    if(hlOnly && !co.posts.some(p=>p.hl)) return false;\n    if(q){\n      const hay=(co.name+co.founder+co.inst+co.rounds+co.statusText+co.posts.map(p=>p.text+p.type).join(\" \")).toLowerCase();\n      if(!hay.includes(q)) return false;\n    }\n    return true;\n  });\n  $(\"#grid\").innerHTML = list.length ? list.map(entryHTML).join(\"\") : `<div class=\"empty\">No companies match these filters.</div>`;\n}\n$(\"#segs\").addEventListener(\"click\",e=>{\n  const b=e.target.closest(\".seg\"); if(!b) return;\n  document.querySelectorAll(\".seg\").forEach(x=>x.classList.remove(\"active\"));\n  b.classList.add(\"active\"); filter=b.dataset.f; render();\n});\n$(\"#q\").addEventListener(\"input\",e=>{query=e.target.value;render();});\n$(\"#hlOnly\").addEventListener(\"change\",e=>{hlOnly=e.target.checked;render();});\n$(\"#rescanBtn\").addEventListener(\"click\",e=>{\n  const prompt=\"Rescan the EQUIP VC/VL awarded companies on LinkedIn and the web, then regenerate EQUIP_Tracker.html with updated posts, recognitions and a fresh timestamp.\";\n  navigator.clipboard.writeText(prompt).then(()=>{\n    const b=e.currentTarget,t=b.textContent;b.classList.add(\"copied\");b.textContent=\"✓ copied — paste to Claude\";\n    setTimeout(()=>{b.classList.remove(\"copied\");b.textContent=t;},2600);\n  });\n});\nrenderLedger(); render();\n</script>\n</body>\n</html>\n"}