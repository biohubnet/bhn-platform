# --- Database (Neon Postgres) ---
# Pooled connection (with ?pgbouncer=true&connect_timeout=10) — used by the app
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct connection (no pooler) — used by Prisma migrate
DIRECT_URL="postgresql://USER:PASS@HOST.neon.tech/dbname?sslmode=require"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# --- Cloudflare R2 (object storage for SCORM packages, certificates, uploads) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="bhn-scorm"
# Public URL of the bucket (R2.dev dev URL or custom domain).
# Example: https://pub-abc123.r2.dev
R2_PUBLIC_URL=""

# --- AI (free-tier providers) ---
# Cloudflare Workers AI — primary provider. Required for embeddings.
# CF_ACCOUNT_ID is the same one used for R2; CF_AI_TOKEN needs "Workers AI:Read" scope.
CF_ACCOUNT_ID=""
CF_AI_TOKEN=""

# Google Gemini — fallback for chat when CF is unavailable.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# --- SMTP (passwordless email-code login) ---
# Any provider works: Gmail App Password, SendGrid SMTP, Brevo, Mailgun, etc.
# Without these set, the email-code login button surfaces a config error.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BHN Training <noreply@example.com>"

# --- Mailchimp newsletter integration ---
# When set, signups that opt in (CASL-compliant active tick) are pushed
# to Mailchimp with status="pending" → Mailchimp emails the user to
# confirm → click flips them to "subscribed". The confirmation click
# is the audit trail; we never single-opt-in.
#
# Where to find these:
#   API key:        Mailchimp Account → Extras → API keys
#   List ID:        Audience → Settings → Audience name and defaults
#   Server prefix:  The "us10" / "us19" / etc. part of the API key
#                   suffix. Optional — derived automatically when omitted.
#   Webhook secret: Generate a random ≥32-char string. Put the same
#                   value in the webhook URL on Mailchimp's side:
#                   https://<your-domain>/api/webhooks/mailchimp?secret=<this>
MAILCHIMP_API_KEY=""
MAILCHIMP_LIST_ID=""
MAILCHIMP_SERVER_PREFIX=""
MAILCHIMP_WEBHOOK_SECRET=""
